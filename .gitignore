# Raw dataset images & large feature caches (downloadable / generated via scripts)
waste-classification-ai-main/data/raw/*
!waste-classification-ai-main/data/raw/.gitkeep
waste-classification-ai-main/data/processed/*
!waste-classification-ai-main/data/processed/.gitkeep
!waste-classification-ai-main/data/processed/splits.csv

# Model binary weights (keep reloop_resnet50_calibrated.pt which is 90.25MB, under GitHub's 100MB limit)
waste-classification-ai-main/models/*.pt
!waste-classification-ai-main/models/.gitkeep
!waste-classification-ai-main/models/model_metadata.json
!waste-classification-ai-main/models/reloop_resnet50_calibrated.pt

